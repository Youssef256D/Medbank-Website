{
  "$description": "MedBank design tokens: the one source for the website (styles.css) and the Flutter app (lib/core/theme/app_tokens.g.dart). Edit here, then run `node design-tokens/generate.mjs`. A value is a literal or a {ref.path} to another token; {\"value\", \"note\"} adds a comment to the output.",

  "font": {
    "family": "Figtree",
    "weights": [400, 500, 600, 700],
    "webFallback": ["ui-sans-serif", "system-ui", "-apple-system", "BlinkMacSystemFont", "\"Segoe UI\"", "sans-serif"],
    "appFallback": ["PlexSansArabic"]
  },

  "radius": { "sm": 10, "md": 14, "lg": 22, "xl": 26 },

  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },

  "type": {
    "headlineMedium": { "size": 28, "weight": 700, "tracking": -0.5 },
    "headlineSmall": { "size": 24, "weight": 700, "tracking": -0.3 },
    "titleLarge": { "size": 22, "weight": 700, "tracking": -0.2 },
    "titleMedium": { "size": 16, "weight": 600 },
    "titleSmall": { "size": 14, "weight": 600 },
    "labelLarge": { "size": 14, "weight": 600 },
    "bodyLarge": { "size": 16, "weight": 400, "height": 1.5 },
    "bodyMedium": { "size": 14, "weight": 400, "height": 1.45 },
    "bodySmall": { "size": 12, "weight": 400 },
    "labelSmall": { "size": 11, "weight": 500 }
  },

  "color": {
    "light": {
      "bg": "#f2f7f5",
      "surface": "rgba(255, 255, 255, 0.84)",
      "surface-strong": "#ffffff",
      "surface-soft": "rgba(255, 255, 255, 0.72)",
      "ink": "#102a43",
      "muted": "#486581",
      "line": "rgba(16, 42, 67, 0.14)",
      "line-strong": "rgba(16, 42, 67, 0.25)",
      "brand": "#177e89",
      "brand-strong": "#11555d",
      "brand-soft": "rgba(23, 126, 137, 0.12)",
      "accent": "#f4a259",
      "danger": "#c43a3a",
      "approval-gap-fg": {
        "value": "#99201f",
        "note": "Approval-gap label. Deliberately NOT --danger: theme-comfort redefines that to #ef4444, a light red meant for dark surfaces, which only reaches 3.1:1 on comfort's parchment card. Comfort inherits this :root value."
      },
      "admin-dash-attention-fg": "#8f1d1d",
      "admin-dash-attention-bg": "#fff0f0",
      "good": "#2b9348",
      "exam-blue": "#3e53a8",
      "exam-blue-2": "#304594",
      "exam-side": "#edf0f6",
      "exam-surface": "#f4f5fb",
      "exam-ink": "#1f2b3d",
      "exam-muted": "#3f4c59",
      "exam-panel-bg": "#f3ead7",
      "data-warn": {
        "value": "#e0a23b",
        "note": "Semantic data-viz amber that stays legible on light & dark tracks. Defined once so all themes share it (unlike --accent, which the dark theme intentionally neutralises to grey)."
      }
    },
    "dark": {
      "bg": "#000000",
      "surface": "rgba(14, 14, 14, 0.94)",
      "surface-strong": "#161616",
      "surface-soft": "rgba(22, 22, 22, 0.96)",
      "ink": "#f5f5f5",
      "muted": "#a6a6a6",
      "line": "rgba(255, 255, 255, 0.14)",
      "line-strong": "rgba(255, 255, 255, 0.28)",
      "brand": "#2a2a2a",
      "brand-strong": "#3a3a3a",
      "brand-soft": "rgba(255, 255, 255, 0.08)",
      "accent": "#8f8f8f",
      "danger": "#ef4444",
      "approval-gap-fg": "#f87171",
      "admin-dash-attention-fg": "#fca5a5",
      "admin-dash-attention-bg": "#2b1515",
      "good": "#22c55e",
      "exam-blue": "#202020",
      "exam-blue-2": "#171717",
      "exam-side": "#080808",
      "exam-surface": "#141414",
      "exam-ink": "#f3f3f3",
      "exam-muted": "#b9c6d8",
      "exam-panel-bg": "#141414"
    },
    "comfort": {
      "bg": "#e8e7e5",
      "surface": "#f0ece3",
      "surface-strong": "#efeae0",
      "surface-soft": "rgba(239, 234, 224, 0.95)",
      "ink": "#4f3f33",
      "muted": "#7a6a5d",
      "line": "rgba(105, 81, 61, 0.22)",
      "line-strong": "rgba(105, 81, 61, 0.36)",
      "brand": "#76563f",
      "brand-strong": "#5d4330",
      "admin-dash-attention-fg": "#7d1d1d",
      "admin-dash-attention-bg": "#f4ded8",
      "brand-soft": "rgba(118, 86, 63, 0.14)",
      "accent": "#9d795d",
      "danger": "#ef4444",
      "good": "#22c55e",
      "exam-blue": "#866448",
      "exam-blue-2": "#6f543d",
      "exam-side": "#ece6dc",
      "exam-surface": "#f3eee5",
      "exam-ink": "#4f3f33",
      "exam-muted": "#6b5a4b",
      "exam-panel-bg": "#f3ece2"
    }
  },

  "app": {
    "$description": "Flutter ColorScheme roles and AppSemanticColors. The app has no comfort theme, and its dark theme keeps a teal brand where the website's goes grey, so dark values are the app's own.",
    "light": {
      "scheme": {
        "primary": "{color.light.brand}",
        "onPrimary": "#ffffff",
        "primaryContainer": { "value": "#cdeaed", "note": "Soft teal (nav, avatars)." },
        "onPrimaryContainer": "#0b3f45",
        "secondaryContainer": { "value": "#d9e6f0", "note": "Calm blue for cards." },
        "onSecondaryContainer": "#1c3a54",
        "surface": "{color.light.bg}",
        "surfaceContainerLowest": "{color.light.surface-strong}",
        "surfaceContainerLow": "{color.light.surface-strong}",
        "surfaceContainer": "#e8f0ef",
        "surfaceContainerHigh": "#dfeae8",
        "surfaceContainerHighest": "#d5e3e1",
        "onSurface": "{color.light.ink}",
        "onSurfaceVariant": "{color.light.muted}",
        "outline": "#b0bcc7",
        "outlineVariant": { "value": "#d5dee5", "note": "Website --line flattened onto white." },
        "error": "{color.light.danger}",
        "onError": "#ffffff",
        "errorContainer": "#f7dbda",
        "onErrorContainer": "#5c1414",
        "tertiary": "{color.light.accent}"
      },
      "semantic": {
        "success": "{color.light.good}",
        "onSuccess": "#ffffff",
        "successContainer": "#d6f2de",
        "onSuccessContainer": "#0a3d24",
        "warning": "#a05a00",
        "onWarning": "#ffffff",
        "warningContainer": "#ffe9cc",
        "onWarningContainer": "#4a2a00"
      }
    },
    "dark": {
      "scheme": {
        "primary": { "value": "#4fc3ce", "note": "Teal, lifted for dark contrast." },
        "onPrimary": "#00363c",
        "primaryContainer": "{color.light.brand-strong}",
        "onPrimaryContainer": "#cff0f3",
        "surface": { "value": "#0a0a0a", "note": "Near the website's #000 dark canvas." },
        "surfaceContainerLowest": "#000000",
        "surfaceContainerLow": "{color.dark.surface-strong}",
        "surfaceContainer": "#1b1b1b",
        "surfaceContainerHigh": "#232323",
        "surfaceContainerHighest": "#2c2c2c",
        "onSurface": "{color.dark.ink}",
        "onSurfaceVariant": "{color.dark.muted}",
        "outline": "#484848",
        "outlineVariant": "#303030",
        "error": "{color.dark.danger}",
        "tertiary": "{color.light.accent}"
      },
      "semantic": {
        "success": "#6fd9a0",
        "onSuccess": "#00391f",
        "successContainer": "#14532d",
        "onSuccessContainer": "#c6f0d8",
        "warning": "#ffbe66",
        "onWarning": "#3e2500",
        "warningContainer": "#6b4300",
        "onWarningContainer": "#ffe3bd"
      }
    }
  }
}
